# Settings the services read from environment variables.
# To run locally, copy this file to .env (which git ignores) and fill in real values.
# Never put a real value in this file: it is committed to a public repository.

# CollegeFootballData.com API key. Request a free one at https://collegefootballdata.com.
# In Google Cloud, this value comes from Secret Manager instead of a file.
CFBD_API_KEY=
